{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 style="color:#6b0f1a; font-weight:800;">Liste des articles</h1>
        <a href="{{ path('app_article_new') }}" class="btn" style="background: linear-gradient(90deg, #6b0f1a, #b91c1c); color:#ffd700; border-radius:25px; font-weight:700; padding:10px 25px;">+ Nouvel article</a>
    </div>
    <div class="table-responsive">
    <table class="table table-bordered table-striped">
        <thead>
            <tr style="background:#0A2342; color:#ffffff;">
                <th style="padding:15px; color:#ffffff !important;">Id</th>
                <th style="padding:15px; color:#ffffff !important;">Titre</th>
                <th style="padding:15px; color:#ffffff !important;">Contenu</th>
                <th style="padding:15px; color:#ffffff !important;">Date de création</th>
                <th style="padding:15px; color:#ffffff !important;">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for article in articles %}
            <tr>
                <td>{{ article.id }}</td>
                <td>{{ article.title }}</td>
                <td>{{ article.content|slice(0, 50) }}...</td>
                <td>{{ article.createdAt ? article.createdAt|date('d/m/Y H:i') : '' }}</td>
                <td>
                    <a href="{{ path('app_article_show', {'id': article.id}) }}" class="btn btn-sm" style="background:#6b0f1a; color:#ffd700; border-radius:20px;">Voir</a>
                    <a href="{{ path('app_article_edit', {'id': article.id}) }}" class="btn btn-sm" style="background:#ffd700; color:#6b0f1a; border-radius:20px; font-weight:700;">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center" style="color:#6b0f1a;">Aucun article trouvé</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}
