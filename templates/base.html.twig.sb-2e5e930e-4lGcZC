<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Mon Blog{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>
            body { background: #fafafa; font-family: 'Georgia', serif; }
            .navbar-custom { background: linear-gradient(90deg, #6b0f1a, #b91c1c); padding: 18px 0; box-shadow: 0 4px 15px rgba(107,15,26,0.4); }
            .navbar-brand { color: #ffd700 !important; font-size: 1.8rem; font-weight: 900; letter-spacing: 4px; text-transform: uppercase; }
            .nav-link { color: #fff !important; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; font-size: 0.85rem; transition: color 0.2s; }
            .nav-link:hover { color: #ffd700 !important; }
            .btn-gold { background: linear-gradient(135deg, #ffd700, #ffa500); color: #6b0f1a; border: none; border-radius: 25px; font-weight: 800; padding: 8px 20px; }
            .btn-gold:hover { background: linear-gradient(135deg, #ffa500, #ffd700); color: #6b0f1a; }
            .btn-outline-gold { border: 2px solid #ffd700; color: #ffd700; border-radius: 25px; font-weight: 700; padding: 6px 18px; }
            .btn-outline-gold:hover { background: #ffd700; color: #6b0f1a; }
        </style>
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand" href="/">Mon Blog</a>
                <button class="navbar-toggler border-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto align-items-center gap-3">
                        <li class="nav-item">
                            <a class="nav-link" href="/article">Articles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/category">Catégories</a>
                        </li>
                        {% if app.user %}
                            <li class="nav-item">
                                <span style="color: #ffd700; font-size: 0.85rem;">{{ app.user.email }}</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-gold btn-sm" href="/logout">Déconnexion</a>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="/login">Connexion</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-gold btn-sm" href="/register">S'inscrire</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        <div class="container mt-4">
            {% block body %}{% endblock %}
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
