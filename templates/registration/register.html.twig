{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow" style="border-radius: 15px; border: none;">
            <div class="card-body p-5">
                <h2 class="fw-bold text-center mb-1">Créer un compte</h2>
                <p class="text-muted text-center mb-4">Rejoignez notre communauté dès aujourd'hui</p>

                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm) }}
                <div class="mb-3">
                    <label class="form-label fw-semibold">Adresse email</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@email.com'}}) }}
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Mot de passe</label>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                </div>
                <div class="mb-4 d-flex align-items-center gap-2">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    <label class="form-label mb-0">J'accepte les conditions d'utilisation</label>
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" style="border-radius: 10px;">
                    S'inscrire
                </button>
                {{ form_end(registrationForm) }}

                <p class="text-center mt-3 text-muted">Déjà un compte ? <a href="/login">Se connecter</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
