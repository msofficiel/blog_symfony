{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 style="color:#6b0f1a; font-weight:800;">Liste des catégories</h1>
        <a href="{{ path('app_category_new') }}" class="btn" style="background: linear-gradient(90deg, #6b0f1a, #b91c1c); color:#ffd700; border-radius:25px; font-weight:700; padding:10px 25px;">+ Créer une catégorie</a>
    </div>
    <table class="table table-striped">
        <thead style="background: linear-gradient(90deg, #6b0f1a, #b91c1c); color:#ffd700;">
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>
                    <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn btn-sm" style="background:#6b0f1a; color:#ffd700; border-radius:20px;">Voir</a>
                    <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm" style="background:#ffd700; color:#6b0f1a; border-radius:20px; font-weight:700;">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3" class="text-center" style="color:#6b0f1a;">Aucune catégorie trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
